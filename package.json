{
  "name": "tierlistbase",
  "version": "0.1.0",
  "private": true,
  "packageManager": "bun@1.3.14",
  "scripts": {
    "dev": "bun run generate:vanguard-hero && next dev --webpack",
    "build": "bun run generate:vanguard-hero && next build --webpack",
    "build:test": "bun run generate:vanguard-hero && APP_ENV=test next build --webpack",
    "start": "next start",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run --config vitest.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts --passWithNoTests",
    "test:contract": "vitest run --config vitest.contract.config.ts --passWithNoTests",
    "test:e2e": "playwright test",
    "test:build-matrix": "bun tests/build/run-feature-matrix.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun scripts/db-migrate.ts",
    "db:verify": "bun scripts/verify-migrations.ts",
    "verify:architecture": "eslint src tests scripts",
    "verify:secrets": "bun scripts/verify-secrets.ts",
    "verify:seo": "bun scripts/verify-seo.ts",
    "verify:seo:production": "playwright test --config playwright.production.config.ts",
    "verify:i18n": "bun scripts/verify-i18n.ts",
    "verify:performance": "playwright test --config playwright.performance.config.ts && playwright test --config playwright.performance-analytics.config.ts",
    "verify:security": "bun scripts/verify-security.ts && APP_ENV=production bun scripts/verify-security.ts",
    "verify:subscription": "bun scripts/verify-subscription.ts",
    "verify:commerce": "bun scripts/verify-commerce.ts",
    "verify:credits": "bun scripts/verify-credits.ts",
    "verify:credit-races": "bun scripts/verify-credit-races.ts",
    "verify:supply-chain": "bun scripts/verify-supply-chain.ts",
    "verify:release": "bun scripts/verify-release.ts",
    "verify": "bun run format:check && bun run lint && bun run typecheck && bun run test:unit && bun run test:integration && bun run test:contract && bun run db:verify && bun run test:build-matrix && bun run verify:architecture && bun run verify:secrets && bun run verify:seo && bun run verify:i18n && bun run verify:security && bun run verify:subscription && bun run verify:commerce && bun run verify:credits && bun run verify:supply-chain && bun run verify:release && bun run verify:performance",
    "dev:vinext": "bun run generate:vanguard-hero && vite dev --port 3001",
    "build:vinext": "bun run generate:vanguard-hero && vite build",
    "start:vinext": "wrangler dev --config dist/server/wrangler.json",
    "deploy:vinext": "vinext-cloudflare deploy --config dist/server/wrangler.json",
    "generate:vanguard-hero": "bun scripts/generate-vanguard-hero-derivatives.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1152.0",
    "@aws-sdk/s3-request-presigner": "3.1152.0",
    "@better-auth/drizzle-adapter": "1.6.25",
    "@cf-wasm/photon": "0.4.0",
    "@waffo/pancake-ts": "0.18.0",
    "better-auth": "1.6.25",
    "drizzle-orm": "0.45.2",
    "next": "16.4.1",
    "postgres": "3.4.9",
    "qrcode": "1.5.4",
    "react": "19.2.9",
    "react-dom": "19.2.9",
    "resend": "6.18.1",
    "server-only": "0.0.1",
    "three": "0.186.1",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@cloudflare/vite-plugin": "1.63.1",
    "@playwright/test": "1.57.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.10.1",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@types/three": "0.186.0",
    "@vinext/cloudflare": "1.1.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitejs/plugin-rsc": "0.5.37",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.1",
    "eslint-config-next": "16.4.1",
    "jsqr": "1.4.0",
    "prettier": "3.7.4",
    "react-server-dom-webpack": "19.2.9",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vinext": "1.1.0",
    "vite": "8.3.3",
    "vitest": "4.1.7",
    "wrangler": "4.149.0",
    "sharp": "0.35.5"
  },
  "overrides": {
    "brace-expansion": "2.1.6",
    "esbuild": "0.28.2",
    "js-yaml": "4.3.2",
    "nanoid": "3.3.18",
    "postcss": "8.5.23",
    "sharp": "0.35.5",
    "source-map-js": "1.2.2",
    "undici": "7.30.1",
    "zod": "4.6.6"
  },
  "type": "module",
  "patchedDependencies": {
    "vinext@1.1.0": "patches/vinext@1.1.0.patch"
  }
}
